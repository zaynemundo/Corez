+
+describe('stripImagesToText', () => {
+  it('leaves image-free content untouched (same reference)', () => {
+    const content = [{ type: 'text', text: 'hi' }]
+    expect(stripImagesToText(content)).toBe(content)
+  })
+
+  it('replaces an image block with the placeholder text', () => {
+    const out = stripImagesToText([{ type: 'text', text: 'see ' }, imageBlock()])
+    expect(out).toEqual([
+      { type: 'text', text: 'see ' },
+      { type: 'text', text: IMAGE_OMITTED_PLACEHOLDER },
+    ])
+    expect(contentHasImage(out)).toBe(false)
+  })
+
+  it('replaces images nested inside tool results', () => {
+    const out = stripImagesToText([
+      { type: 'tool-result', toolCallId: 't1', content: [imageBlock(), { type: 'text', text: 'gen' }] },
+    ])
+    expect(out).toEqual([
+      {
+        type: 'tool-result',
+        toolCallId: 't1',
+        content: [{ type: 'text', text: IMAGE_OMITTED_PLACEHOLDER }, { type: 'text', text: 'gen' }],
+      },
+    ])
+    expect(contentHasImage(out)).toBe(false)
+  })
+})
+
+describe('stripMessageImagesToText', () => {
+  it('returns the same list when no message has an image', () => {
+    const messages = [createUserMessage({
+      content: [{ type: 'text', text: 'hi' }],
+      source: { kind: 'plugin', plugin: 'test' },
+    })]
+    expect(stripMessageImagesToText(messages)).toBe(messages)
+  })
+
+  it('replaces images in in-history messages and freezes the result', () => {
+    const messages = [
+      createUserMessage({
+        content: [{ type: 'text', text: 'screenshot' }, imageBlock()],
+        source: { kind: 'plugin', plugin: 'test' },
+      }),
+      createUserMessage({
+        content: [{ type: 'text', text: 'please continue' }],
+        source: { kind: 'plugin', plugin: 'test' },
+      }),
+    ]
+    const out = stripMessageImagesToText(messages)
+    expect(out).not.toBe(messages)
+    // The image-free message is reused; the image-bearing one is sanitized.
+    expect(out[1]).toBe(messages[1])
+    expect(contentHasImage(out[0].content)).toBe(false)
+    expect(out[0].content).toContainEqual({ type: 'text', text: IMAGE_OMITTED_PLACEHOLDER })
+    expect(Object.isFrozen(out[0])).toBe(true)
+  })
+})
