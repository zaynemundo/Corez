 /** Content-block structure helpers. @module @deepseek-ai/dsh-llm/content */
 
 import type { ContentBlock } from './types.ts'
+import { freezeMessage } from './message.ts'
 import type { Message } from './message.ts'
 
 /** Model-facing stand-in for an image removed to fit a provider request bound. */
 export const OFFLOADED_IMAGE_TEXT
   = '[image omitted to keep the request within its image limit; older images are omitted first. If this image is still needed, read its file again when a path is available; otherwise ask the user to attach it again.]'
 
+/** Placeholder text replacing an image a text-only model cannot see. */
+export const IMAGE_OMITTED_PLACEHOLDER = '[Image attached — omitted: this model does not support image input]'
+
 /**
  * True when typed model content contains an image block, walking nested
  * tool-result content. This is the one recursive image walk shared by every
@@ -92,3 +96,41 @@ export function offloadRequestImages(
     return content === message.content ? message : { ...message, content }
   })
 }
+
+/**
+ * Replace every image block (nested tool-result images included) with the
+ * text placeholder, keeping the message structure and all other blocks.
+ * Returns the original array (same reference) when nothing changed.
+ * @param content - typed model content blocks.
+ * @returns content with images replaced, or the same reference when none.
+ */
+export function stripImagesToText(content: readonly ContentBlock[]): ContentBlock[] {
+  const out = content.map((block): ContentBlock => {
+    if (block.type === 'image') {
+      return { type: 'text', text: IMAGE_OMITTED_PLACEHOLDER }
+    }
+    if (block.type === 'tool-result' && contentHasImage(block.content)) {
+      const inner = stripImagesToText(block.content)
+      return inner === block.content ? block : { ...block, content: inner }
+    }
+    return block
+  })
+  return out.every((block, index) => block === content[index]) ? (content as ContentBlock[]) : out
+}
+
+/**
+ * Serialize a message list for a text-only model: image blocks in every
+ * message become the text placeholder so an in-history attachment (from a
+ * turn handled by a vision model) does not kill the whole request. The
+ * returned messages are freshly frozen; messages without images are reused.
+ * @param messages - the conversation to sanitize.
+ * @returns the same list when no message contained an image, else the
+ *   sanitized, frozen list.
+ */
+export function stripMessageImagesToText(messages: readonly Message[]): readonly Message[] {
+  const out = messages.map((message) => {
+    const content = stripImagesToText(message.content)
+    return content === message.content ? message : freezeMessage({ ...message, content })
+  })
+  return out.every((message, index) => message === messages[index]) ? messages : out
+}
