diff --git a/packages/llm/llm-pi-ai/src/stream.ts b/packages/llm/llm-pi-ai/src/stream.ts
index d45df45a39..6969288ad6 100644
--- a/packages/llm/llm-pi-ai/src/stream.ts
+++ b/packages/llm/llm-pi-ai/src/stream.ts
@@ -110,6 +110,20 @@ export function mapStopReason(message: AssistantMessage, contextWindow?: number)
     }
     case 'error': {
       const text = message.errorMessage ?? 'pi-ai stream error'
+      // Some OpenAI-compatible gateways close a CONTENT-BEARING stream without
+      // ever sending the terminal chunk that carries `finish_reason` (the
+      // OpenCode Zen Go gateway's muse route ends with `{"choices":[],"cost":"0"}`
+      // and no finish_reason anywhere). pi-ai reports that as a stream error,
+      // and classifying it as TRANSPORT would retry forever — the same wire
+      // behavior repeats every attempt. When the output already carries text
+      // or tool calls, the response IS complete: only the terminal marker is
+      // missing, so map it to the successful finish it represents.
+      if (/stream ended (?:before|without)\b/i.test(text)) {
+        const hasToolCalls = message.content.some(block => block.type === 'toolCall')
+        const hasText = message.content.some(block => block.type === 'text' && block.text.length > 0)
+        if (hasToolCalls) return { kind: 'tool-calls' }
+        if (hasText) return { kind: 'stop' }
+      }
       return { kind: 'error', failure: { message: text, code: classifyPiAiError(text) } }
     }
   }
