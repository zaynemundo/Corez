+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <style>
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body { background: #000000; color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, system-ui; overflow: hidden; height: 100vh; font-weight: 400; }
