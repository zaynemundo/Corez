{
  "name": "corez-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/sync-shared.mjs && expo start",
    "android": "node scripts/sync-shared.mjs && expo run:android",
    "prebuild": "node scripts/sync-shared.mjs && expo prebuild --platform android",
    "apk": "npm run prebuild && cd android && gradlew.bat assembleRelease",
    "postinstall": "node scripts/sync-shared.mjs",
    "test": "node scripts/sync-shared.mjs && jest",
    "test:watch": "node scripts/sync-shared.mjs && jest --watch",
    "lint": "node scripts/sync-shared.mjs && expo lint",
    "typecheck": "node scripts/sync-shared.mjs && tsc --noEmit",
    "doctor": "expo-doctor",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "@corez_ai/shared": "file:../packages/corez-shared",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo-google-fonts/outfit": "0.4.3",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.107.1",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-webview": "14.0.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  }
}
