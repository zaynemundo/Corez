{
  "expo": {
    "name": "Corez",
    "slug": "corez",
    "scheme": "corez",
    "version": "0.1.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pro.corez.app",
      "buildNumber": "10",
      "icon": "./assets/icon-ios.png",
      "associatedDomains": [
        "applinks:corez.pro"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Corez saves generated images to your photo library when you ask it to.",
        "NSFaceIDUsageDescription": "Corez does not use Face ID."
      }
    },
    "android": {
      "package": "pro.corez.app",
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "corez.pro",
              "pathPrefix": "/chat"
            },
            {
              "scheme": "https",
              "host": "corez.pro",
              "pathPrefix": "/sites"
            },
            {
              "scheme": "https",
              "host": "corez.pro",
              "pathPrefix": "/share/chat"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCmakeStlFix",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Corez does not use Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Corez uses the camera to attach photos to your prompts.",
          "photosPermission": "Corez uses your photos to attach images to your prompts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Corez uses the microphone for voice dictation."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
