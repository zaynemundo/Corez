+/* Inline Market Instrument */
+.market-card {
+  width: min(100%, 720px);
+  max-width: 100%;
+  min-width: 0;
+  display: grid;
+  gap: 0.9rem;
+  color: var(--text-primary);
+  overflow-wrap: anywhere;
+}
+
+.market-card-header,
+.market-price-row,
+.market-card-footer {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 0.75rem;
+  flex-wrap: wrap;
+}
+
+.market-card-header {
+  padding-bottom: 0.75rem;
+  border-bottom: 1px solid var(--border-color);
+}
+
+.market-identity,
+.market-quote {
+  min-width: 0;
+}
+
+.market-card-header strong,
+.market-price {
+  display: block;
+}
+
+.market-asset-name {
+  font-weight: 500;
+  letter-spacing: -0.01em;
+}
+
+.market-card-header span,
+.market-card-footer {
+  color: var(--text-secondary);
+  font-size: 0.75rem;
+}
+
+.market-status-group {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 0.4rem;
+  flex-wrap: wrap;
+}
+
+.market-refresh-state {
+  color: var(--text-muted);
+}
+
+.market-status {
+  border: 1px solid var(--border-color);
+  border-radius: var(--radius-sm);
+  padding: 0.2rem 0.45rem;
+  color: var(--text-primary);
+  font-size: 0.72rem;
+  line-height: 1.4;
+}
+
+.market-status-stale,
+.market-status-delayed {
+  border-color: var(--market-caution);
+  border-style: dashed;
+}
+
+.market-price {
+  font-size: clamp(1.7rem, 5vw, 2.5rem);
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -0.04em;
+  line-height: 1.15;
+}
+
+.market-movement {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  margin-top: 0.25rem;
+  color: var(--text-secondary);
+  font-weight: 500;
+  font-variant-numeric: tabular-nums;
+}
+
+.market-movement-up {
+  color: var(--market-positive);
+}
+
+.market-movement-down {
+  color: var(--market-negative);
+}
+
+.market-refresh,
+.market-retry,
+.market-ranges button {
+  min-height: 44px;
+  border: 1px solid var(--border-color);
+  border-radius: var(--radius-sm);
+  background: var(--bg-tertiary);
+  color: var(--text-primary);
+  cursor: pointer;
+  transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
+}
+
+.market-refresh,
+.market-retry {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.4rem;
+  padding: 0.55rem 0.75rem;
+}
+
+.market-refresh[aria-busy="true"] svg {
+  animation: market-refresh-spin 0.8s linear infinite;
+}
+
+.market-refresh:disabled,
+.market-retry:disabled,
+.market-ranges button:disabled,
+.market-controls input:disabled,
+.market-controls select:disabled {
+  cursor: not-allowed;
+  opacity: 0.55;
+}
+
+.market-card :focus-visible {
+  outline: 2px solid var(--text-primary);
+  outline-offset: 2px;
+}
+
+.market-chart-block {
+  min-width: 0;
+}
+
+.market-ranges {
+  display: flex;
+  gap: 0.4rem;
+  margin-bottom: 0.5rem;
+}
+
+.market-ranges button {
+  min-width: 44px;
+  padding: 0.45rem 0.65rem;
+}
+
+.market-ranges button[aria-pressed="true"] {
+  border-color: var(--text-primary);
+  box-shadow: inset 0 0 0 1px var(--text-primary);
+}
+
+.market-chart {
+  display: block;
+  width: 100%;
+  max-width: 100%;
+  height: clamp(9rem, 30vw, 11rem);
+  border: 1px solid var(--border-color);
+  border-radius: var(--radius-md);
+  background: var(--bg-secondary);
+  color: var(--text-secondary);
+}
+
+.market-chart polyline {
+  stroke: currentColor;
+  stroke-width: 2;
+}
+
+.market-chart-empty {
+  margin-top: 0.4rem;
+  color: var(--text-muted);
+  font-size: 0.75rem;
+}
+
+.market-controls {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0.65rem;
+  min-width: 0;
+}
+
+.market-controls label {
+  min-width: 0;
+  display: grid;
+  gap: 0.3rem;
+  color: var(--text-secondary);
+  font-size: 0.75rem;
+}
+
+.market-controls input,
+.market-controls select {
+  width: 100%;
+  max-width: 100%;
+  min-width: 0;
+  min-height: 44px;
+  border: 1px solid var(--border-color);
+  border-radius: var(--radius-sm);
+  background: var(--bg-secondary);
+  color: var(--text-primary);
+  padding: 0.5rem 0.65rem;
+}
+
+.market-conversion {
+  min-width: 0;
+  font-size: 1.2rem;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+
+.market-conversion-label {
+  color: var(--text-secondary);
+  font-size: 0.75rem;
+  font-weight: 300;
+}
+
+.market-card-footer {
+  padding-top: 0.75rem;
+  border-top: 1px solid var(--border-color);
+  align-items: flex-start;
+}
+
+.market-card-error {
+  padding-left: 0.75rem;
+  border-left: 2px solid var(--market-caution);
+}
+
+.market-error-message {
+  color: var(--text-secondary);
+}
+
+@media (hover: hover) {
+  .market-refresh:not(:disabled):hover,
+  .market-retry:not(:disabled):hover,
+  .market-ranges button:not(:disabled):hover {
+    background: var(--bg-secondary);
+    border-color: var(--border-hover);
+  }
+}
+
+@keyframes market-refresh-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
 /* Markdown Elements Styling */
 .markdown-body {
   display: flex;
