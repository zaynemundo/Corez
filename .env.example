# CoreZ AI - Environment Configuration
# Copy this file to .env and fill in your values

# === AI Provider Keys ===

# OpenCode Go API Key - the only AI provider (chat, code, swarm, agent)
# Get yours at: https://opencode.ai
OPENCODE_GO_API_KEY=
OPENCODE_API_KEY=

# Optional OpenCode Go overrides
# OPENCODE_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
# OPENCODE_MODEL=deepseek-v4-flash

# === Cloudflare (for production deployment) ===

# Twelve Data API Key - Market data provider for stock/crypto/forex quotes
# Get yours at: https://twelvedata.com/apikey
TWELVE_DATA_API_KEY=

# === Canvas Preview (optional overrides) ===

# Vite dev server port
VITE_PORT=3000
