# CoreZ AI - Environment Configuration
# Copy this file to .env and fill in your values

# === AI Provider Keys ===

# DeepSeek API Key - PRIMARY AI provider for chat and code
# Get yours at: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# DeepSeek model (default: deepseek-v4-flash -> DeepSeek-V4-Flash-0731)
# Official API models: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_MODEL=

# OpenRouter API Key - Fallback AI provider (used when DeepSeek is unavailable)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenCode Go API Key - Alternative AI provider (falls back to OpenRouter)
# Get yours at: https://opencode.ai
OPENCODE_GO_API_KEY=
OPENCODE_API_KEY=

# Cloudflare Workers AI - Final fallback LLM provider
# Configured via wrangler; no env var needed here.

# === Cloudflare (for production deployment) ===

# Twelve Data API Key - Market data provider for stock/crypto/forex quotes
# Get yours at: https://twelvedata.com/apikey
TWELVE_DATA_API_KEY=

# === Canvas Preview (optional overrides) ===

# Vite dev server port
VITE_PORT=3000
