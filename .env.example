# CoreZ AI - Environment Configuration
# Copy this file to .env and fill in your values

# === AI Provider Keys ===

# OpenCode Go API Key - ONLY text provider for Cloudflare Chat (/api/ai)
# Get yours at: https://opencode.ai — chat uses OPENCODE_GO_API_KEY only, no DeepSeek/OpenRouter fallback
OPENCODE_GO_API_KEY=
OPENCODE_API_KEY=

# Optional OpenCode Go overrides.
# OPENCODE_MODEL and OPENCODE_BUILD_MODEL are clamped to the single allowed
# model (muse-spark-1.3-contributor): a stale or unapproved value cannot redirect
# text traffic. See packages/agent-core/providers/modelIds.js.
# OPENCODE_ENDPOINT=https://opencode.ai/zen/go/v1/responses
# OPENCODE_MODEL=muse-spark-1.3-contributor
# Endpoint API mode: the default /responses endpoint selects the Responses API
# that Muse Spark requires. Set "chat" only when OPENCODE_ENDPOINT points at a
# chat-completions URL.
# OPENCODE_API_MODE=responses
# Reasoning hints are model-specific; set truthy when the configured model is
# not a reasoning model so no reasoning field is sent.
# OPENCODE_REASONING_DISABLED=false
# Visible reasoning (the live "Thinking" panel) needs `store: true` and
# `include: ['reasoning.encrypted_content']` on the Responses API. Set this to
# false when responses must not be stored server-side; the panel then shows its
# honest empty state instead of reasoning text.
# OPENCODE_RESPONSES_STORE=true
# Build phase model for the creation harness (@game / @website / apps): the
# agentic build, its continuations, and repair rounds run on this model while
# planning, review, chat, and titles keep OPENCODE_MODEL. Defaults to
# muse-spark-1.3-contributor (the site-wide default).
# OPENCODE_BUILD_MODEL=muse-spark-1.3-contributor
# Search ranking on the OpenCode Go gateway (used first, same key as the
# chat model): rerank with voyageai/rerank-2.5, embeddings fallback with
# perplexity/pplx-embed-v1-0.6b.
# OPENCODE_RERANK_MODEL=voyageai/rerank-2.5
# OPENCODE_EMBED_MODEL=perplexity/pplx-embed-v1-0.6b
# OPENCODE_RERANK_DISABLED=false
# OPENCODE_EMBED_DISABLED=false

# Reasoning effort and temperature overrides. Without them the worker derives
# both from the prompt's complexity and intent (worker/modelRouter.js): trivial
# and low get low effort, medium gets medium, high and epic get xhigh. Setting
# OPENCODE_REASONING_EFFORT (or AI_REASONING_EFFORT) pins ONE effort for every
# request; OPENCODE_TEMPERATURE (or AI_TEMPERATURE) pins the temperature
# instead of the per-intent table. Leave them unset unless you are trading
# latency or token cost for depth on purpose.
# OPENCODE_REASONING_EFFORT=high
# OPENCODE_TEMPERATURE=0.4
# AI_REASONING_EFFORT=xhigh
# AI_TEMPERATURE=0.42

# Role-specific model overrides. Every text path is clamped through
# `resolveTextModel` (packages/agent-core/providers/modelIds.js), whose allowlist
# holds exactly one model, so any other value is replaced by
# `muse-spark-1.3-contributor`: these names cannot redirect text traffic today.
# They exist so a future multi-model allowlist needs no new plumbing.
# OPENCODE_DEFAULT_MODEL=muse-spark-1.3-contributor
# OPENCODE_LOGIC_MODEL=muse-spark-1.3-contributor
# OPENCODE_VISUAL_MODEL=muse-spark-1.3-contributor

# Blended token prices used ONLY to estimate spend for dashboards and logs
# (worker/utils.js estimateCostUsd). They never influence billing: plans are
# metered by request count, never by money.
# AI_COST_PER_M_INPUT_USD=0.14
# AI_COST_PER_M_OUTPUT_USD=0.28

# No DeepSeek-direct keys: CoreZ routes text exclusively through OpenCode Go
# and no longer constructs a DeepSeek or OpenRouter text adapter.

# OpenRouter API Key - image provider ONLY for /api/image (chat no longer
# falls back to OpenRouter). Get yours at: https://openrouter.ai
# OPENROUTER_API_KEY=

# Image model chain override for /api/image: single model id used instead of
# the default chain (google/gemini-3.1-flash-lite-image).
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# OpenRouter search ranking fallback (requires OPENROUTER_API_KEY): used only
# when the OpenCode Go gateway cannot rank. Re-ranks merged web search results
# by relevance with a rerank model, falling back to embedding cosine
# similarity when the rerank model is unavailable.
# OPENROUTER_RERANK_MODEL=voyageai/rerank-2.5
# OPENROUTER_EMBED_MODEL=perplexity/pplx-embed-v1-0.6b
# OPENROUTER_RERANK_DISABLED=false
# OPENROUTER_EMBED_DISABLED=false

# Disable chat provider (any truthy value disables OpenCode Go for /api/ai)
# OPENCODE_GO_DISABLED=false

# === Remote repository runner (SELF-HOSTED / PRIVATE USE ONLY) ===
# The public Worker never executes repository tasks and never delegates to a
# remote workspace. For private/self-hosted deployments that want repository
# execution through the website API, run packages/cli/src/remoteRunnerServer.js
# on a Node host and point the Worker at it. Do NOT configure these on a
# public deployment.
# COREZ_REMOTE_RUNNER_URL=https://runner.example.com
# COREZ_REMOTE_RUNNER_TOKEN=shared-secret-with-the-runner
# COREZ_REMOTE_WORKSPACES=/srv/checkouts/corez,/srv/checkouts/games

# === Cloudflare (for production deployment) ===

# Long builds: Cloudflare imposes no wall-clock limit on an incoming request
# while the client stays connected (only a 30s CPU cap), so a creation build
# may take as long as it needs. Tune the self-imposed envelopes here:
# AI_HARNESS_TIMEOUT_MS - total wall-clock budget per harness invocation
#   (default 600000 / 10 minutes). The build is aborted with an explicit
#   retryable error when exceeded.
# AI_HARNESS_CHECKPOINT_MS - how often the partial artifact is persisted
#   mid-stream (default 10000 / 10s). An interrupted build resumes from the
#   last checkpoint (re-verify -> repair) instead of restarting from zero.
# AI_HARNESS_TIMEOUT_MS=600000
# AI_HARNESS_CHECKPOINT_MS=10000

# Swarm pre-pass: complex (non-fast-path) creation builds run a small swarm
# of PARALLEL specialist briefs (architect, art-director) whose short
# contributions feed the single streamed build — a better-informed first
# artifact, fewer repair rounds (less wall time and worker CPU). Never a
# gate: failed specialists fall back to the plain build context. Games and
# trivial/low-complexity requests always skip it. Set to false to disable.
# AI_SWARM_ENABLED=true
# AI_SWARM_TIMEOUT_MS=25000

# Provider deadlines for the non-streaming calls a build makes.
# AI_SPEC_TIMEOUT_MS - planning/spec deadline (default 20000). The spec is a short
#   internal brief, so a hung provider surfaces as a retryable error in ~20s
#   instead of burning a whole build's budget.
# AI_NONSTREAM_TIMEOUT_MS - fallback deadline for a non-streaming provider call;
#   when set it also replaces the spec deadline above.
# AI_SPEC_TIMEOUT_MS=20000
# AI_NONSTREAM_TIMEOUT_MS=90000

# SSE heartbeat for streamed responses (default 15000 ms). A comment frame keeps
# a long silent build from being treated as a dead connection by mobile networks
# and proxies.
# COREZ_HEARTBEAT_MS=15000

# Exa API Key - premium neural web search provider (/api/search). When set,
# Exa leads the provider chain; keyless Wikipedia + DuckDuckGo still merge
# in as backstops. Get yours at: https://exa.ai
EXA_API_KEY=

# Web search also works fully keyless (DuckDuckGo + Wikipedia).

# Workers AI ranking (uses the AI binding from wrangler.jsonc, no key): rerank
# and embeddings serve /api/search inside the daily free neuron allocation. Set
# either to "true" to skip that step and go straight to the keyed providers.
# WORKERS_AI_RERANK_DISABLED=false
# WORKERS_AI_EMBED_DISABLED=false

# === Durable task queue (POST /api/tasks) ===
# The binding (TASKS_QUEUE -> corez-tasks) lives in wrangler.jsonc; these are the
# knobs the consumer reads (worker/taskRunner.js).
# TASKS_QUEUE_MAX_ATTEMPTS - attempts per message before the task fails honestly
#   instead of redelivering forever (default 12).
# TASK_DISPATCH_RETRY_DELAY_SECONDS - delay before a deferred dispatch from the
#   D1 outbox is re-sent (default 30).
# TASK_INLINE_FALLBACK=true - run tasks inline when no queue is bound. Local dev
#   and contract tests only: a production deployment must fail honestly rather
#   than silently changing the execution model.
# TASKS_QUEUE_MAX_ATTEMPTS=12
# TASK_DISPATCH_RETRY_DELAY_SECONDS=30
# TASK_INLINE_FALLBACK=false

# === n8n Webhook Bridge (webhook-only, no API key) ===
# Optional default webhook URL for /api/n8n/webhook (you can also pass webhookUrl per request)
# Get yours from n8n: Workflow → Webhook node → copy Production URL (https://<n8n>/webhook/<id>)
# N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/corez-events
# Optional shared secret sent as X-Corez-Secret header so the n8n workflow can verify origin
# N8N_WEBHOOK_SECRET=optional-shared-secret
# N8N_WEBHOOK_TIMEOUT_MS=8000
# Target policy (worker/n8nBridge.js): https only, and loopback/private hosts are
# refused so the bridge cannot be pointed at the deployment's own internals. These
# two relax it for local development ONLY — never set them on a public deployment.
# N8N_ALLOW_HTTP=0
# N8N_ALLOW_PRIVATE=0

# === Canvas Preview (optional overrides) ===

# Vite dev server port
VITE_PORT=3000
# --- Auth Gate (D1 + JWT) ---
# Required to enable login wall. Generate with: openssl rand -base64 32
# AUTH_SECRET=change-me-to-a-long-random-string
# Production marker used by the auth gate: `production` makes a deployment
# without AUTH_SECRET refuse protected routes (retryable 503) instead of
# accepting bearer-less requests as the development identity. Set it in
# wrangler.jsonc `vars`; only local dev/test should use `development`.
# ENVIRONMENT=production
# Plans: free (0 AED), standard (18.36 AED), premium (27.54 AED) — stored per user
# Invite codes are deprecated and no longer required for signup (kept for backward compat)
# INVITE_CODES=COREZ-INVITE-2026,COREZ-VIP-2026
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# The dev identity is granted ONLY on non-production hosts (localhost, *.test)
# and is refused when ENVIRONMENT declares production.
# COREZ_ENV is the older name of the same marker and is read as a fallback, so
# either variable can declare the deployment's environment.
# COREZ_ENV=production
# AUTH_RESET_TOKEN_IN_RESPONSE=1  # dev only: expose the password-reset token in the response when RESEND_API_KEY is absent (never enable in production)

# Outbound email (password resets) goes through Resend: RESEND_API_KEY is what
# lets mail leave, RESEND_FROM is the verified sender the user sees.
# RESEND_FROM=CoreZ <no-reply@your-domain.example>

# === Ziina Payment Gateway ===
# Get yours at: https://ziina.com — used for /api/payments/ziina
# ZIINA_API_KEY=your-ziina-api-key
# ZIINA_API_TOKEN=alias-accepted-for-ZIINA_API_KEY
# ZIINA_WEBHOOK_SECRET=optional-webhook-signing-secret
# Test/live mode is a DEPLOYMENT setting, never a client one: ZIINA_TEST_MODE=true
# (or ZIINA_MODE=test) runs checkout against the sandbox and allows the billing
# smoke tests. Anything else spends real money.
# ZIINA_TEST_MODE=false

# === Custom domains for published pages (NOT SHIPPED) ===
# worker/customDomains.js implements Cloudflare-for-SaaS custom hostnames, but its
# HTTP surface is not routed: nothing calls handleDomainsApi or
# handleCustomDomainRequest, so these change nothing a visitor can reach yet. Only
# domainRecordKey is live (the storage migration writes its pointer). Configure
# them when the feature is wired — see the STATUS block in that module.
# CF_API_TOKEN=cloudflare-api-token-with-ssl-and-certificates-edit
# CF_ZONE_ID=your-zone-id
# CUSTOM_HOSTNAME_FALLBACK_ORIGIN=customers.corez.pro
# CUSTOM_DOMAINS_DISABLED=false

# === Per-plan usage metering ===
# Every paid provider call is counted per account per UTC month in the D1 table
# `usage_counters` (messages, tokens, swarm_runs, images, publishes) and refused
# with a 402 once the plan's budget is spent. Limits live in worker/usage.js:
# Free 20 generations / 10 build runs / 10 images / 3 publishes / 1 published
# page, Standard 200 / 100 / 200 / 50 / 10, Premium unlimited. Tokens are the
# provider's reported usage where the response carries it, otherwise an estimate
# (about four characters per token), and both are recorded in the same counter.
# Without D1 nothing is metered and nothing is ever blocked.
# Set to 1 to accept every request without counting or limiting it.
# USAGE_METERING_DISABLED=0

# === Consent-gated first-party analytics ===
# /api/analytics/collect stores aggregate counters (day, event, path, country,
# device) in D1 — no IP address, user agent, user id or full URL is ever
# written. The client only sends events after the visitor allows the Analytics
# category, and honours Do Not Track / Global Privacy Control. Set to 1 to
# accept-and-discard without storing anything (the client is unaffected).
# ANALYTICS_DISABLED=0
