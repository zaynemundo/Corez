{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat",
  "main": "./worker/entry.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Production marker for the auth gate (worker/auth.js isProductionRequest):
  // with `production` declared, a deployment that loses its AUTH_SECRET
  // refuses protected routes (retryable 503) instead of accepting bearer-less
  // requests as the development identity. Every real deployment must keep
  // this; `wrangler dev` can override it locally with ENVIRONMENT=development.
  "vars": {
    "ENVIRONMENT": "production"
  },
  // CPU ceiling per invocation: 30s on Workers Paid (the Free plan rejected
  // this with code 100328 and hard-caps at 10ms, which caused the recurring
  // exceededCpu mid-build stream deaths). 30s gives the harness ~300x the
  // CPU it needs for even large game builds.
  "limits": {
    "cpu_ms": 30000
  },
  // Smart Placement: run this Worker at the Cloudflare PoP closest to the
  // OpenCode Zen origin (US-hosted) instead of closest to each visitor, so
  // the worker -> opencode.ai fetch (the long pole of every AI response)
  // stays on the shortest intra-Cloudflare hop.
  "placement": {
    "mode": "smart"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  // Workers AI binding: powers the /api/image/cf endpoint (FLUX.2 klein-4b
  // text-to-image), the /api/rerank endpoint (bge-reranker-base) and the
  // /api/embed endpoint (bge-m3) on the account's own Workers AI — no
  // third-party key, billed inside the daily free neuron allocation. Search
  // ranking also uses it first (rerank then embeddings) before keyed
  // providers; disable with WORKERS_AI_RERANK_DISABLED / WORKERS_AI_EMBED_DISABLED.
  // D1 restored 2026-08-19: corez-auth re-created (8ab37b35-7c23-4a9b-896c-d1953d71bec5)
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corez-auth",
      "database_id": "8ab37b35-7c23-4a9b-896c-d1953d71bec5"
    }
  ],
  "migrations": [
    {
      "tag": "v1-game-rooms",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "corez-assets"
    }
  ],
  // Durable task execution. POST /api/tasks hands each task to this queue
  // instead of running it inside the HTTP invocation, so an HTTP disconnect
  // or isolate eviction can never cancel a task: the consumer (entry.js
  // `queue()` -> worker/taskRunner.js) redelivers and resumes from the
  // persisted D1 state. Run `npx wrangler queues create corez-tasks` once
  // before the first deploy that uses it; `wrangler deploy` creates missing
  // producer queues automatically but the versioned pipeline
  // (`wrangler versions upload`) does not, hence the explicit step.
  // max_batch_size 1: one long model task per invocation. retry_delay 30s
  // bounds provider backoff redelivery; the consumer also fails the stored
  // task honestly once its own attempt cap is spent.
  "queues": {
    "producers": [
      {
        "binding": "TASKS_QUEUE",
        "queue": "corez-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "corez-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 12,
        "retry_delay": 30,
        "max_concurrency": 6
      }
    ]
  },
  // Dispatch-outbox recovery. When a queue send fails, POST /api/tasks
  // persists the dispatch in D1 (`harness_task_dispatches`) and returns
  // `dispatch: "deferred"`; the Worker scheduled handler re-sends due records.
  // Queue batches also sweep, so a queue that recovers heals deferred work
  // without cron. Deploy the trigger once with
  // `npx wrangler triggers deploy` (the versioned pipeline does not sync
  // triggers).
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  // Read-through cache for the Awwwards design references (/api/inspiration and
  // the app-build prompt enrichment). The scrape costs one category page plus
  // up to three detail pages on every build; the category listing changes on
  // the order of days, so the parsed result is cached per category for 6 hours
  // (14-day hard expiry) and a failed refresh falls back to the stale copy.
  "kv_namespaces": [
    {
      "binding": "INSPIRATION_CACHE",
      "id": "da51c6ee70c5465eb032b162af02572c"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "routes": [
    { "pattern": "corez.pro", "custom_domain": true },
    { "pattern": "chat.corez.pro", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}