{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat",
  "main": "./worker/entry.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // NOTE: CPU limits (limits.cpu_ms) cannot be set on the Free plan — the
  // API rejects them with code 100328. The Free plan hard-caps invocations
  // at 10ms CPU, which medium/complex harness builds can exceed (recurring
  // exceededCpu stream deaths). After upgrading to Workers Paid, add:
  //   "limits": { "cpu_ms": 30000 }
  // to raise the cap to 30s (up to 5 minutes).
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-game-rooms",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "corez-assets"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "routes": [
    { "pattern": "corez.pro", "custom_domain": true },
    { "pattern": "chat.corez.pro", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
