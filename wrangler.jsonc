{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai",
  "main": "./worker/entry.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-game-rooms",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "corez-assets"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "routes": [
    { "pattern": "corez.pro", "custom_domain": true },
    { "pattern": "www.corez.pro", "custom_domain": true },
    { "pattern": "sandbox.corez.pro", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
