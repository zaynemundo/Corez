{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai",
  "main": "./worker/swarm-index.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "subrequests": 1000
  },
  "workers_dev": false,
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "corez-assets"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "routes": [
    { "pattern": "corez.pro", "custom_domain": true },
    { "pattern": "www.corez.pro", "custom_domain": true },
    { "pattern": "sandbox.corez.pro", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
