{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-18",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
