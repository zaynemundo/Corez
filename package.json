    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "vite": "^6.1.0",
    "wrangler": "^4.112.0"
  }
